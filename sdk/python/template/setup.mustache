from setuptools import setup, find_packages  # noqa: H301
from setuptools.command.install import install


class PostInstallCommand(install):
    def run(self):
        super().run()
        print("\nTIP: Don't have Kameleo installed yet? Get it at https://kameleo.io/downloads.\n")

# To install the library, run the following
#
# python setup.py install
#
# prerequisite: setuptools
# http://pypi.python.org/pypi/setuptools
#
# the package metadata is in pyproject.toml

setup(
    cmdclass={"install": PostInstallCommand},
    packages=find_packages(exclude=["test", "tests"]) + ["kameleo.local_api_client.bin"],
    include_package_data=True,
    package_data={
        "kameleo.local_api_client": [
            "py.typed",
            "bin/win-x64/pw-bridge.exe",
            "bin/linux-x64/pw-bridge",
            "bin/osx-arm64/pw-bridge",
        ]
    },
)
