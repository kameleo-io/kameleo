{
  "name": "@kameleo/local-api-client",
  "version": "5.1.0",
  "author": "Kameleo Team",
  "description": "This JavaScript/TypeScript package provides convenient access to the Local API REST interface of the Kameleo Client.",
  "engines": {
    "node": ">=16"
  },
  "keywords": [
    "kameleo",
    "stealth browsing platform",
    "anti-detect browser",
    "selenium",
    "webdriver",
    "browser automation",
    "web scraping",
    "puppeteer",
    "playwright",
    "headless",
    "chrome",
    "firefox",
    "chromium",
    "safari",
    "edge"
  ],
  "license": "MIT",
  "homepage": "https://kameleo.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/kameleo-io/kameleo.git"
  },
  "bugs": {
    "url": "https://github.com/kameleo-io/kameleo/issues"
  },
  "files": [
    "bin",
    "dist",
    "postinstall.js",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "browser": "./dist/esm/index.browser.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json",
    "prepack": "npm run build",
    "postinstall": "node postinstall.js"
  },
  "devDependencies": {
    "@types/node": "^16",
    "typescript": "5.9.3"
  }
}
