String[] videoPaths = []

def runCommand(String cmd) {
    isUnix() ? sh(cmd) : powershell(cmd)
}

pipeline {
    agent any
    options {
        disableConcurrentBuilds()
        timeout(time: 20, unit: 'MINUTES')
    }
    environment {
        ARTIFACTORY_REPOSITORY = 'masking-audit'
    }
    parameters {
        text(name: 'videoPaths', defaultValue: '',
             description: '''\
                               Enter Nexus video file paths to publish.
                               Accepted formats: separate lines, whitespace/comma separated list or a JSON array.

                               Provide paths relative to repository root (DO NOT include the 'repo/' prefix).

                               Example: windows/123/google-windows-chrome-260316053516.webm,macos/124/brotector-macos-firefox-260316080530.webm

                               Example:
                                    windows/123/google-windows-chrome-260316053516.webm
                                    macos/124/brotector-macos-firefox-260316080530.webm
                            ''')
    }

    stages {
        stage('Parse job parameters') {
            steps {
                script {
                    // parse any combination of comma / whitespace separated lists or JSON arrays
                    videoPaths = params.videoPaths.tokenize('"`\'[]{},; \n\r\t').findAll { it.length() >= 6 }

                    if (!videoPaths) {
                        error('No video paths provided')
                    }

                    // Validate paths: ensure .webm extension; strip any accidental leading repo prefix
                    videoPaths = videoPaths.collect { p ->
                        def trimmed = p.trim()
                        if (!trimmed.endsWith('.webm')) {
                            error("Invalid file path: ${trimmed}. All paths must be .webm video files.")
                        }
                        def prefix = env.ARTIFACTORY_REPOSITORY + '/'
                        trimmed.startsWith(prefix) ? trimmed.substring(prefix.length()) : trimmed
                    }
                    echo "Video paths to publish: \n\t${videoPaths.join('\n\t')}"
                }
            }
        }

        stage('Init Repository') {
            options { timeout(time: 5, unit: 'MINUTES') }
            steps {
                runCommand 'git clean -fd'
                runCommand 'git reset --hard HEAD'

                runCommand 'npm ci'
            }
        }

        stage('Publish Videos') {
            steps {
                withCredentials([
                    string(credentialsId: 'nexus-artifactory-hostname', variable: 'ARTIFACTORY_HOSTNAME'),
                    usernamePassword(credentialsId: 'nexus-artifactory', usernameVariable: 'ARTIFACTORY_USERNAME', passwordVariable: 'ARTIFACTORY_PASSWORD'),
                    string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN'),
                ]) {
                    withEnv(["VIDEO_PATHS=${videoPaths.join(',')}"]) {
                        runCommand 'node build/publishVideos.ts'
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Videos published successfully'
            echo "Published video paths:\n\t${videoPaths.join('\n\t')}"
        }
        failure {
            echo 'Failed to publish videos'
            echo "Attempted paths: ${videoPaths ? ('\n\t' + videoPaths.join('\n\t')) : 'none provided'}"
        }
    }
}
