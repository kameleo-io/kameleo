String emailOverride = null
String kernelsOverride = null
String artifactUrlOverrides = null

def runCommand(String cmd) {
    isUnix() ? sh(cmd) : powershell(cmd)
}

pipeline {
    agent none
    options { disableConcurrentBuilds() }
    environment {
        ARTIFACTORY_REPOSITORY = 'masking-audit'
    }
    parameters {
        string(name: 'emailOverride', defaultValue: emailOverride)
        text(name: 'artifactUrlOverrides', defaultValue: artifactUrlOverrides)
        text(name: 'kernelsOverride', defaultValue: kernelsOverride)
    }

    stages {
        stage('Parse parameters') {
            steps {
                script {
                    emailOverride = params.emailOverride?.trim() ?: emailOverride
                    artifactUrlOverrides = params.artifactUrlOverrides?.trim() ?: artifactUrlOverrides
                    kernelsOverride = params.kernelsOverride?.trim() ?: kernelsOverride

                    echo "Report email recipient override: ${emailOverride}"
                    echo "Artifact url override: ${artifactUrlOverrides}"
                    echo "Kernels override: ${kernelsOverride}"
                }
            }
        }
        stage('Matrix') {
            matrix {
                // restrict to a single agent per OS for consistency
                axes {
                    axis {
                        name 'AGENT'
                        values 'windows11', 'macos', 'ubuntu'
                    }
                }
                agent { label "${AGENT} && gui" }
                stages {
                    stage('Init Repository') {
                        options { timeout(time: 5, unit: 'MINUTES') }
                        steps {
                            runCommand 'git clean -fxd'
                            runCommand 'git reset --hard HEAD'
                            runCommand 'npm ci'
                        }
                    }
                    stage('Run Masking Report') {
                        options { timeout(time: 25, unit: 'MINUTES') }
                        steps {
                            withCredentials([
                                string(credentialsId: 'nexus-artifactory-hostname', variable: 'ARTIFACTORY_HOSTNAME'),
                                string(credentialsId: 'ma-adscore-api', variable: 'ADSCORE_API_KEY'),
                                usernamePassword(credentialsId: 'nexus-artifactory', usernameVariable: 'ARTIFACTORY_USERNAME', passwordVariable: 'ARTIFACTORY_PASSWORD'),
                                usernamePassword(credentialsId: 'ma-app-login', usernameVariable: 'KAM_EMAIL', passwordVariable: 'KAM_PASSWORD'),
                                usernamePassword(credentialsId: 'ma-proxy', usernameVariable: 'PROXY_USERNAME', passwordVariable: 'PROXY_PASSWORD'),
                            ]) {
                                script {
                                    if (artifactUrlOverrides) env.ARTIFACT_URL_OVERRIDES = artifactUrlOverrides
                                    if (kernelsOverride) env.KAM_KERNELS_OVERRIDE = kernelsOverride

                                    int testExitCode = isUnix()
                                        ? sh(script: 'npm test', returnStatus: true)
                                        : powershell(script: 'npm test', returnStatus: true)

                                    echo "npm test exited with ${testExitCode} (ignored by design)"
                                }
                            }
                        }
                        post {
                            always {
                                junit skipPublishingChecks: true, testResults: 'dist/test-result.xml', skipOldReports: false

                                withCredentials([
                                    string(credentialsId: 'nexus-artifactory-hostname', variable: 'ARTIFACTORY_HOSTNAME'),
                                    usernamePassword(credentialsId: 'nexus-artifactory', usernameVariable: 'ARTIFACTORY_USERNAME', passwordVariable: 'ARTIFACTORY_PASSWORD'),
                                    string(credentialsId: 'brevo-api-key', variable: 'BREVO_API_KEY'),
                                    string(credentialsId: 'ma-email-sender', variable: 'REPORT_EMAIL_SENDER'),
                                    string(credentialsId: 'ma-email-recipient', variable: 'REPORT_EMAIL_RECIPIENT_DEFAULT'),
                                ]) {
                                    script {
                                        if (artifactUrlOverrides) env.ARTIFACT_URL_OVERRIDES = artifactUrlOverrides
                                        if (kernelsOverride) env.KAM_KERNELS_OVERRIDE = kernelsOverride
                                        env.REPORT_EMAIL_RECIPIENT = emailOverride ?: env.REPORT_EMAIL_RECIPIENT_DEFAULT

                                        runCommand 'node build/sendEmail.ts'
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
