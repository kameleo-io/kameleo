String[] videoPaths = []

def runCommand(String cmd) {
    isUnix() ? sh(cmd) : powershell(cmd)
}

pipeline {
    agent any
    options {
        disableConcurrentBuilds()
        timeout(time: 20, unit: 'MINUTES')
    }
    environment {
        ARTIFACTORY_REPOSITORY = 'masking-report'
    }
    parameters {
        string(name: 'runIdOverride', defaultValue: '', description: 'Optional CI job number to publish instead of the latest run')
    }

    stages {
        stage('Init Repository') {
            options { timeout(time: 5, unit: 'MINUTES') }
            steps {
                runCommand 'npm ci'
            }
        }

        stage('Publish run') {
            steps {
                withCredentials([
                    string(credentialsId: 'nexus-artifactory-hostname', variable: 'ARTIFACTORY_HOSTNAME'),
                    usernamePassword(credentialsId: 'nexus-artifactory', usernameVariable: 'ARTIFACTORY_USERNAME', passwordVariable: 'ARTIFACTORY_PASSWORD'),
                    string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN'),
                ]) {
                    withEnv(["RUN_ID_OVERRIDE=${params.runIdOverride}"]) {
                        runCommand 'node build/publishRun.ts'
                    }
                }
            }
        }
    }
}
